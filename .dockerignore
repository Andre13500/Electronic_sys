# =============================================================================
# .DOCKERIGNORE — Archivos que NO se copian al contexto de Docker
#
# Excluir estos archivos reduce drásticamente el tamaño del build context
# (de ~500 MB a ~5 MB) y evita que datos locales lleguen a producción.
# =============================================================================

# ── Node.js ──────────────────────────────────────────────────────────────────
# node_modules se reinstala desde package.json dentro del Dockerfile
**/node_modules
frontend/dist

# ── .NET ─────────────────────────────────────────────────────────────────────
# bin/ y obj/ se regeneran con dotnet build/publish dentro del Dockerfile
**/bin
**/obj

# ── Git ──────────────────────────────────────────────────────────────────────
.git
.gitignore

# ── Base de datos local ───────────────────────────────────────────────────────
# La BD de desarrollo no debe subirse; en producción se crea automáticamente
**/*.db
**/*.db-shm
**/*.db-wal

# ── Fotos subidas localmente ──────────────────────────────────────────────────
# En producción se guardan en el disco persistente de Render (/data/uploads)
backend/InformesTecnicos.Api/uploads

# ── Archivos de entorno ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Scripts y configs solo de desarrollo ─────────────────────────────────────
start.bat
start.sh

# ── IDE ───────────────────────────────────────────────────────────────────────
.vs
.vscode
*.user
