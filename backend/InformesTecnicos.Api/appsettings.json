{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "Swagger": {
    "Enabled": true
  },
  "_NOTA_SECRETOS": "La cadena de conexión (ConnectionStrings:conectionSql) y la clave Jwt:Key se cargan desde appsettings.Secrets.json (no versionado) o desde variables de entorno. Ver appsettings.Secrets.example.json.",

  "Jwt": {
    "Issuer": "InformesTecnicos",
    "Audience": "InformesTecnicos.Clients",
    "ExpiresMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5000"
    ]
  },

  "RateLimit": {
    "LoginWindowSeconds": 60,
    "LoginMaxRequests": 10,
    "ApiWindowSeconds": 60,
    "ApiMaxRequests": 120
  }
}