{
  // ==========================================================================
  // CONFIGURACIÓN DE PRODUCCIÓN — Se aplica cuando ASPNETCORE_ENVIRONMENT=Production
  // Los valores aquí sobreescriben appsettings.json.
  // Las variables de entorno de Render (doble guion bajo como separador)
  // tienen prioridad sobre este archivo; úsalas para valores secretos.
  //
  // Ejemplo de variable de entorno en Render:
  //   Jwt__Key  →  equivale a  cfg["Jwt:Key"]
  // ==========================================================================
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    // Ruta al archivo SQLite en el disco persistente de Render.
    // El disco se monta en /data según render.yaml.
    // Si no hay disco (plan free), el archivo es efímero y se pierde al redesplegar.
    "Default": "Data Source=/data/informes.db"
  },
  "Jwt": {
    // IMPORTANTE: NO uses este valor en producción.
    // Sobreescribe Jwt__Key en las variables de entorno de Render con una clave
    // aleatoria y larga (mínimo 32 caracteres). Render puede generarla
    // automáticamente si usas generateValue: true en render.yaml.
    "Key": "CAMBIAR_EN_RENDER_ENV_VARS_minimo_32_chars_xxxx",
    "Issuer": "InformesTecnicos",
    "Audience": "InformesTecnicos.Clients",
    "ExpiresMinutes": 480
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
